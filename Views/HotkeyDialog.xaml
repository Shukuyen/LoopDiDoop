<Window x:Class="LoopDiDoop.Views.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoopDiDoop — Hotkey Setup"
        Width="440" Height="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#18181B"
            BorderBrush="#3F3F46"
            BorderThickness="1"
            CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Set Your Hotkey"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF" />
                <TextBlock Text="Hold this key to record your voice; release to start looping."
                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                           FontSize="13"
                           Foreground="#A1A1AA"
                           Margin="0,4,0,16" />
            </StackPanel>

            <!-- Interactive Capture Box -->
            <Border Grid.Row="1"
                    x:Name="CaptureBox"
                    Background="#27272A"
                    BorderBrush="#06B6D4"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="16,14,16,14"
                    Focusable="True"
                    Cursor="Hand"
                    MouseDown="OnCaptureBoxMouseDown">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="HotkeyDisplayText"
                               Text="Ctrl + Alt + Space"
                               FontFamily="Segoe UI Variable Display, Segoe UI, monospace"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Press any key or combination on your keyboard"
                               FontFamily="Segoe UI Variable Small, Segoe UI, sans-serif"
                               FontSize="11"
                               Foreground="#71717A"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Quick Presets -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="Or choose a popular preset:"
                           FontFamily="Segoe UI Variable Small, Segoe UI, sans-serif"
                           FontSize="12"
                           Foreground="#71717A"
                           Margin="0,0,0,8" />
                <WrapPanel>
                    <Button Content="Ctrl + Alt + Space" Margin="0,0,6,6"
                            Padding="10,5,10,5" Background="#27272A" Foreground="#E4E4E7" BorderThickness="0"
                            Click="OnPresetCtrlAltSpaceClick" />
                    <Button Content="CapsLock" Margin="0,0,6,6"
                            Padding="10,5,10,5" Background="#27272A" Foreground="#E4E4E7" BorderThickness="0"
                            Click="OnPresetCapsLockClick" />
                    <Button Content="Scroll Lock" Margin="0,0,6,6"
                            Padding="10,5,10,5" Background="#27272A" Foreground="#E4E4E7" BorderThickness="0"
                            Click="OnPresetScrollLockClick" />
                    <Button Content="F8" Margin="0,0,6,6"
                            Padding="10,5,10,5" Background="#27272A" Foreground="#E4E4E7" BorderThickness="0"
                            Click="OnPresetF8Click" />
                </WrapPanel>
            </StackPanel>

            <!-- Pass-through option -->
            <CheckBox Grid.Row="3"
                      x:Name="PassThroughCheckBox"
                      Content="Pass hotkey to other apps (allows normal typing &amp; toggles)"
                      Foreground="#A1A1AA"
                      FontFamily="Segoe UI Variable Small, Segoe UI, sans-serif"
                      FontSize="12"
                      IsChecked="True"
                      Margin="0,14,0,0" />

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel"
                        Padding="16,8,16,8"
                        Margin="0,0,10,0"
                        Background="#27272A"
                        Foreground="#E4E4E7"
                        BorderThickness="0"
                        Click="OnCancelClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Save Hotkey"
                        Padding="18,8,18,8"
                        Background="#0284C7"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="OnSaveClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

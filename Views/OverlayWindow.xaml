<Window x:Class="LoopDiDoop.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoopDiDoop Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Pulse animation for recording red dot -->
        <Storyboard x:Key="RecPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecDot" Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.35" Duration="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="RecDotScale" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.25" Duration="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="RecDotScale" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.25" Duration="0:0:0.6" />
        </Storyboard>

        <!-- Loop rotation animation -->
        <Storyboard x:Key="LoopRotateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoopRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:3.5" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16" x:Name="RootContainer" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="-35" />
        </Grid.RenderTransform>

        <!-- Main Dynamic Island Capsule -->
        <Border CornerRadius="22"
                Background="#EE16161A"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                Padding="16,8,16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Direction="270" Color="#000000" />
            </Border.Effect>

            <Grid>
                <!-- RECORDING VIEW -->
                <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Visible">
                    <!-- Red Recording Indicator -->
                    <Grid Width="20" Height="20" Margin="0,0,10,0">
                        <Ellipse Width="18" Height="18" Fill="#33EF4444" />
                        <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#EF4444" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="RecDotScale" ScaleX="1.0" ScaleY="1.0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="Recording"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <!-- Live VU Level Indicator Bar -->
                    <Border Width="36" Height="6" Background="#27272A" CornerRadius="3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border x:Name="LevelBar" Width="0" Height="6" HorizontalAlignment="Left" CornerRadius="3" Background="#22C55E" />
                    </Border>

                    <!-- Elapsed / Max Timer -->
                    <TextBlock x:Name="TimerText"
                               Text="0:00 / 0:30"
                               FontFamily="Segoe UI Variable Small, Segoe UI, monospace"
                               FontSize="12"
                               Foreground="#A1A1AA"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- LOOPING VIEW -->
                <StackPanel x:Name="LoopingPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Looping Icon -->
                    <Grid Width="20" Height="20" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="LoopRotate" Angle="0" />
                        </Grid.RenderTransform>
                        <Path Fill="#06B6D4" Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Looping"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <!-- Hint Pill -->
                    <Border Background="#27272A" CornerRadius="10" Padding="8,3,8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="LoopHintText"
                                   Text="Press hotkey to clear"
                                   FontFamily="Segoe UI Variable Small, Segoe UI, sans-serif"
                                   FontSize="11"
                                   Foreground="#38BDF8" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
